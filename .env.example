# Optional: copy to .env and fill in. run_all.sh loads .env if present.

# Telegram bot (from @BotFather). When set, run_all.sh starts the bot.
# TELEGRAM_BOT_TOKEN=your_token_here

# Backend URL used by the Telegram bot (default: http://127.0.0.1:8000)
# EXPENSE_API_URL=http://127.0.0.1:8000

# Tavily API key for Finance News tab (get one at tavily.com)
# TAVILY_API_KEY=tvly-your_key_here
